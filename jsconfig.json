{
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@/components": ["./components"],
      "@/components/*": ["./components/*"],
      "@/app/*": ["./app/*"],
      "@/hooks": ["./hooks"],
      "@/hooks/*": ["./hooks/*"],
      "@/store": ["./store"],
      "@/store/*": ["./store/*"],
      "@/providers": ["./providers"],
      "@/providers/*": ["./providers/*"],
      "@/utils": ["./utils"],
      "@/utils/*": ["./utils/*"],
      "@/constants": ["./constants"],
      "@/constants/*": ["./constants/*"],
      "@/config": ["./config"],
      "@/config/*": ["./config/*"],
      "@/lib/*": ["./lib/*"],
      "@/schemas": ["./schemas"],
      "@/schemas/*": ["./schemas/*"],
      "@/services": ["./services"],
      "@/services/*": ["./services/*"],
      "@/middleware": ["./middleware"],
      "@/types": ["./types"],
      "@/features/*": ["./features/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", "**/*.js", "**/*.jsx"],
  "exclude": ["node_modules"]
}
