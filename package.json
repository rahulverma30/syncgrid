{
  "name": "syncgrid",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise-Grade Agency ERP & Company Management System",
  "author": "SyncGrid",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,css}\"",
    "prepare": "husky install"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "next-themes": "^0.4.6",
    "zustand": "^5.0.0",
    "react-hook-form": "^7.51.0",
    "zod": "^3.22.0",
    "@hookform/resolvers": "^3.3.0",
    "@tanstack/react-table": "^8.17.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.408.0",
    "clsx": "^2.0.0",
    "tailwind-merge": "^2.2.0",
    "sonner": "^1.3.0",
    "class-variance-authority": "^0.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "autoprefixer": "^10.4.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "prettier": "^3.2.0",
    "husky": "^8.0.0",
    "lint-staged": "^15.2.0"
  }
}
